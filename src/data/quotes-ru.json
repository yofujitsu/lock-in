[
  { "text": "Краткость — сестра таланта.", "source": "Антон Чехов" },
  { "text": "Тише едешь — дальше будешь.", "source": "Пословица" },
  { "text": "Век живи — век учись.", "source": "Пословица" },
  { "text": "Безумству храбрых поём мы песню.", "source": "Максим Горький" },
  { "text": "Мы в ответе за тех, кого приручили.", "source": "Антуан де Сент-Экзюпери" },
  { "text": "Слово — серебро, молчание — золото.", "source": "Пословица" },
  { "text": "Семь раз отмерь — один раз отрежь.", "source": "Пословица" },
  { "text": "Без труда не вытащишь и рыбку из пруда.", "source": "Пословица" },
  { "text": "Делу время, потехе час.", "source": "Пословица" },
  { "text": "Повторение — мать учения.", "source": "Пословица" },
  { "text": "Ученье — свет, а неученье — тьма.", "source": "Пословица" },
  { "text": "Что написано пером, того не вырубишь топором.", "source": "Пословица" },
  { "text": "Слово не воробей, вылетит — не поймаешь.", "source": "Пословица" },
  { "text": "Лучше один раз увидеть, чем сто раз услышать.", "source": "Пословица" },
  { "text": "Друзья познаются в беде.", "source": "Пословица" },
  { "text": "В гостях хорошо, а дома лучше.", "source": "Пословица" },
  { "text": "Глаза боятся, а руки делают.", "source": "Пословица" },
  { "text": "Смелость города берёт.", "source": "Пословица" },
  { "text": "На ошибках учатся.", "source": "Пословица" },
  { "text": "Терпение и труд всё перетрут.", "source": "Пословица" },
  { "text": "Человек — это звучит гордо.", "source": "Максим Горький" },
  { "text": "Всё течёт, всё меняется.", "source": "Гераклит" },
  { "text": "Познай самого себя.", "source": "Сократ" },
  { "text": "Я мыслю, следовательно, я существую.", "source": "Рене Декарт" },
  { "text": "Человек есть мера всех вещей.", "source": "Протагор" },
  { "text": "Умный любит учиться, а дурак — учить.", "source": "Антон Чехов" },
  { "text": "Надо, чтобы за дверью каждого довольного человека стоял кто-нибудь с молоточком.", "source": "Антон Чехов" },
  { "text": "Чем ночь темней, тем ярче звёзды.", "source": "Аполлон Майков" },
  { "text": "Служить бы рад, прислуживаться тошно.", "source": "Александр Грибоедов" },
  { "text": "Счастливые часов не наблюдают.", "source": "Александр Грибоедов" },
  { "text": "И дым отечества нам сладок и приятен.", "source": "Александр Грибоедов" },
  { "text": "Гений и злодейство — две вещи несовместные.", "source": "Александр Пушкин" },
  { "text": "Привычка свыше нам дана: замена счастию она.", "source": "Александр Пушкин" },
  { "text": "Любви все возрасты покорны.", "source": "Александр Пушкин" },
  { "text": "Учись, мой сын: наука сокращает нам опыты быстротекущей жизни.", "source": "Александр Пушкин" },
  { "text": "Чем меньше женщину мы любим, тем легче нравимся мы ей.", "source": "Александр Пушкин" },
  { "text": "Умом Россию не понять.", "source": "Фёдор Тютчев" },
  { "text": "Недаром помнит вся Россия про день Бородина.", "source": "Михаил Лермонтов" },
  { "text": "Была без радости любовь, разлука будет без печали.", "source": "Михаил Лермонтов" },
  { "text": "Красота спасёт мир.", "source": "Фёдор Достоевский" },
  { "text": "Свобода есть осознанная необходимость.", "source": "Бенедикт Спиноза" },
  { "text": "Знание — сила.", "source": "Фрэнсис Бэкон" },
  { "text": "Всё, что нас не убивает, делает нас сильнее.", "source": "Фридрих Ницше" },
  { "text": "Жить — значит действовать.", "source": "Анатоль Франс" },
  { "text": "Лучше поздно, чем никогда.", "source": "Тит Ливий" }
]
